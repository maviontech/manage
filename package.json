{
  "name": "trackline-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind build pipeline for the Trackline (manage) Django app",
  "scripts": {
    "build:css": "tailwindcss -i ./project_management/core/static/core/css/tailwind.src.css -o ./project_management/core/static/core/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./project_management/core/static/core/css/tailwind.src.css -o ./project_management/core/static/core/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
