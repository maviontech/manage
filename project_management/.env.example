# Copy this file to .env and replace all placeholder values.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
SESSION_COOKIE_AGE=1800

# MySQL administrator connection used by db_initializer and tenant management
MYSQL_ADMIN_HOST=127.0.0.1
MYSQL_ADMIN_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PWD=replace-with-your-mysql-password
MASTER_DB_NAME=master_db

# Redis (used when DJANGO_DEBUG=False)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Email (console backend is suitable for local development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@trackline.com
